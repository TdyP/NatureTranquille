# ===========================================
# NatureTranquille - Production Environment
# ===========================================
# Copy this file to .env.prod and fill in the values
# NEVER commit .env.prod to version control

# Database Configuration
POSTGRES_DB=naturetranquille
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Backend API Configuration
API_PORT=4000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://backend:4000
NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json

# Analytics (optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# SMTP Configuration (optional - for feedback emails)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hello@naturetranquille.fr
