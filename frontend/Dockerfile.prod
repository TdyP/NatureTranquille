# Stage 1: Install and build (development dependencies needed)
FROM node:24-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including dev for build)
RUN npm ci

# Copy all source files
COPY . .

# NEXT_PUBLIC_* vars are inlined at build time, so they must be set here
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_MAPLIBRE_STYLE
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID
ARG NEXT_PUBLIC_UMAMI_SCRIPT_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_MAPLIBRE_STYLE=$NEXT_PUBLIC_MAPLIBRE_STYLE
ENV NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID
ENV NEXT_PUBLIC_UMAMI_SCRIPT_URL=$NEXT_PUBLIC_UMAMI_SCRIPT_URL

# Build the Next.js application
# Note: glob deprecation warnings are from devDependencies (Jest, ESLint)
# They are not used in production and can be safely ignored
RUN npm run build

# Stage 2: Production image
FROM node:24-alpine

WORKDIR /app

# Copy production dependencies from builder
COPY --from=builder /app/node_modules ./node_modules

# Copy package files
COPY --from=builder /app/package*.json ./

# Copy built files
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.js ./next.config.js

# Copy source files (needed for Next.js runtime)
COPY --from=builder /app/app ./app
COPY --from=builder /app/components ./components
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/types ./types

# Set production environment
ENV NODE_ENV=production
ENV PORT=3000

# Run Next.js in production mode
CMD ["npm", "run", "start"]
